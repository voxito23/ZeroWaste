  "panels": [
    {"type":"row","title":"FILA 1 — DISPONIBILIDAD","gridPos":{"h":1,"w":24,"x":0,"y":0},"id":1},
    {"type":"stat","title":"Estado público de www","description":"Disponibilidad agregada de las rutas públicas supervisadas. Un cero indica al menos una ruta caída.","targets":[{"expr":"min(probe_success{job=\"blackbox-public\"}) or on() vector(0)","legendFormat":"Sitio público","refId":"A"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"CAÍDO","color":"red"},"1":{"text":"DISPONIBLE","color":"green"}}}],"min":0,"max":1,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","justifyMode":"center","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"value_and_name"},"gridPos":{"h":5,"w":6,"x":0,"y":1},"id":2},
    {"type":"stat","title":"Health y readiness por nodo","description":"Si todos aparecen SIN TARGET, falta crear prometheus/targets/origins.yml con las IP privadas reales de ambos servidores.","targets":[{"expr":"max(probe_success{job=\"blackbox-origins\",node_role=\"primary\",probe=\"health\"}) or on() vector(0)","legendFormat":"Servidor 1 · health","refId":"A"},{"expr":"max(probe_success{job=\"blackbox-origins\",node_role=\"primary\",probe=\"ready\"}) or on() vector(0)","legendFormat":"Servidor 1 · readiness","refId":"B"},{"expr":"max(probe_success{job=\"blackbox-origins\",node_role=\"secondary\",probe=\"health\"}) or on() vector(0)","legendFormat":"Servidor 2 · health","refId":"C"},{"expr":"max(probe_success{job=\"blackbox-origins\",node_role=\"secondary\",probe=\"ready\"}) or on() vector(0)","legendFormat":"Servidor 2 · readiness","refId":"D"}],"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"SIN TARGET / NO LISTO","color":"red"},"1":{"text":"LISTO","color":"green"}}}],"min":0,"max":1,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","justifyMode":"center","orientation":"horizontal","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"value_and_name"},"gridPos":{"h":5,"w":12,"x":6,"y":1},"id":3},
    {"type":"stat","title":"Nodos y failover observado","description":"El failover es una inferencia: principal sin health, secundario con health y ruta pública disponible. No cambia DNS automáticamente.","targets":[{"expr":"sum(probe_success{job=\"blackbox-origins\",probe=\"health\"}) or on() vector(0)","legendFormat":"Nodos disponibles","refId":"A"},{"expr":"(((max(probe_success{job=\"blackbox-origins\",node_role=\"primary\",probe=\"health\"}) or on() vector(0)) == bool 0) * ((max(probe_success{job=\"blackbox-origins\",node_role=\"secondary\",probe=\"health\"}) or on() vector(0)) == bool 1) * ((min(probe_success{job=\"blackbox-public\"}) or on() vector(0)) == bool 1))","legendFormat":"Failover observado","refId":"B"}],"fieldConfig":{"defaults":{"min":0,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"yellow","value":1},{"color":"green","value":2}]}},"overrides":[{"matcher":{"id":"byName","options":"Failover observado"},"properties":[{"id":"mappings","value":[{"type":"value","options":{"0":{"text":"NO","color":"green"},"1":{"text":"SÍ","color":"yellow"}}}]}]}]},"options":{"colorMode":"background","graphMode":"none","justifyMode":"center","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"value_and_name"},"gridPos":{"h":5,"w":6,"x":18,"y":1},"id":4},
    {"type":"row","title":"FILA 2 — INFRAESTRUCTURA","gridPos":{"h":1,"w":24,"x":0,"y":6},"id":10},
    {"type":"timeseries","title":"CPU, RAM y load por nodo","targets":[{"expr":"100-(avg by(instance_name)(rate(node_cpu_seconds_total{mode=\"idle\",instance_name=~\"$instance_name\"}[5m]))*100)","legendFormat":"CPU {{instance_name}}"},{"expr":"100*(1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)","legendFormat":"RAM {{instance_name}}"},{"expr":"node_load1","legendFormat":"load {{instance_name}}"}],"gridPos":{"h":7,"w":12,"x":0,"y":7},"id":11},
    {"type":"timeseries","title":"Disco, red, reinicios y uptime","targets":[{"expr":"100*(1-node_filesystem_avail_bytes{mountpoint=\"/\"}/node_filesystem_size_bytes{mountpoint=\"/\"})","legendFormat":"disk {{instance_name}}"},{"expr":"rate(node_network_receive_bytes_total[5m])","legendFormat":"network {{instance_name}}"},{"expr":"changes(container_start_time_seconds{name!=\"\"}[10m])","legendFormat":"restarts {{name}}"},{"expr":"time()-node_boot_time_seconds","legendFormat":"uptime {{instance_name}}"}],"gridPos":{"h":7,"w":12,"x":12,"y":7},"id":12},
    {"type":"row","title":"FILA 3 — APLICACIONES","gridPos":{"h":1,"w":24,"x":0,"y":14},"id":20},
    {"type":"stat","title":"Servicios y readiness real por servidor","description":"La readiness integral comprueba Laravel, FastAPI, Flask, Supabase, Redis y almacenamiento en cada Droplet real.","targets":[{"expr":"up{service=~\"fastapi|flask|caddy|nginx|redis\"}","legendFormat":"{{service}} · {{instance_name}}"},{"expr":"probe_success{job=\"blackbox-origins\",probe=\"ready\"}","legendFormat":"Readiness integral · {{instance_name}}"}],"gridPos":{"h":6,"w":24,"x":0,"y":15},"id":21},
    {"type":"row","title":"FILA 4 — TRÁFICO","gridPos":{"h":1,"w":24,"x":0,"y":21},"id":30},
    {"type":"timeseries","title":"Peticiones, códigos, latencias y activas por nodo","targets":[{"expr":"sum by(instance_name,status)(rate(http_requests_total[5m]))","legendFormat":"{{instance_name}} {{status}}"},{"expr":"histogram_quantile(0.95,sum by(le,instance_name)(rate(http_request_duration_seconds_bucket[5m])))","legendFormat":"p95 {{instance_name}}"},{"expr":"sum by(instance_name)(http_requests_inprogress)","legendFormat":"active {{instance_name}}"}],"gridPos":{"h":7,"w":24,"x":0,"y":22},"id":31},
    {"type":"row","title":"FILA 5 — SEGURIDAD","gridPos":{"h":1,"w":24,"x":0,"y":29},"id":40},
    {"type":"timeseries","title":"Protección real: login, límites globales y bloqueos WAF","description":"Métricas emitidas actualmente por FastAPI. Los bloqueos WAF se separan por motivo y los contadores se agregan por réplica.","targets":[{"expr":"sum by(instance_name)(rate(zerowaste_login_failures_total[5m]))","legendFormat":"Login fallido · {{instance_name}}","refId":"A"},{"expr":"sum by(instance_name)(rate(zerowaste_login_lockouts_total[5m]))","legendFormat":"Login bloqueado · {{instance_name}}","refId":"B"},{"expr":"sum by(instance_name)(rate(zerowaste_rate_limits_total[5m]))","legendFormat":"Rate limit · {{instance_name}}","refId":"C"},{"expr":"sum by(instance_name,reason)(rate(zerowaste_firewall_blocks_total[5m]))","legendFormat":"WAF {{reason}} · {{instance_name}}","refId":"D"}],"gridPos":{"h":6,"w":24,"x":0,"y":30},"id":41},
    {"type":"row","title":"FILA 6 — NEGOCIO","gridPos":{"h":1,"w":24,"x":0,"y":36},"id":50},
    {"type":"timeseries","title":"Recolecciones, QR, puntos, canjes, comunidad y usuarios","targets":[{"expr":"sum by(__name__)(increase({__name__=~\"zerowaste_(collections|qr_completed|points_awarded|redemptions|posts|comments|active_users)_total\"}[1h]))","legendFormat":"{{__name__}}"}],"gridPos":{"h":7,"w":24,"x":0,"y":37},"id":51}
  ],
