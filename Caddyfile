zerowaste-qro.com, www.zerowaste-qro.com {
    # Cabeceras de seguridad SSL / TLS A+ completas para el dominio
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
    }

    # Laravel (Panel Admin — Servidor Privado)
    handle /zw-interno* {
        reverse_proxy admin:80
    }

    # FastAPI (Backend / API — Servidor Privado)
    handle_path /api* {
        reverse_proxy fast_api:6000
    }

    # FastAPI Docs y Redoc (Protegidos con login de admin)
    handle /zw-docs* {
        reverse_proxy fast_api:6000
    }
    handle /zw-openapi.json {
        reverse_proxy fast_api:6000
    }
    handle /zw-redoc* {
        reverse_proxy fast_api:6000
    }

    # Prometheus — Monitoreo del Sistema (solo acceso interno)
    handle /prometheus* {
        reverse_proxy prometheus:9090
    }

    # Grafana — Dashboard de Monitoreo
    handle /grafana* {
        reverse_proxy grafana:3000
    }

    # Flask (Resto del sitio — Servidor Público)
    handle {
        reverse_proxy cliente:5000
    }
}
