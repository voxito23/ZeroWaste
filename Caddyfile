{
	admin off
	metrics {
		per_host
	}
}

# Read-only process telemetry for Prometheus. Port 2019 is internal to Docker;
# the mutable Caddy administration API is disabled globally.
:2019 {
	handle /metrics {
		metrics
	}
	handle /health {
		respond "ok" 200
	}
	respond 404
}

zerowaste-qro.com {
	redir https://www.zerowaste-qro.com{uri} 308
}

www.zerowaste-qro.com {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@private path /metrics /metrics/* /api/metrics /api/metrics/* /grafana/metrics /grafana/metrics/* /prometheus /prometheus/* /stub_status /nginx-health
	respond @private 404

	handle /grafana {
		redir /grafana/ 308
	}
	handle /grafana/* {
		reverse_proxy grafana:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	@legacy_rewards path_regexp legacy_rewards ^/images/recompensas/(.+)$
	redir @legacy_rewards /media/recompensas/{re.legacy_rewards.1} 308

	@legacy_profiles path_regexp legacy_profiles ^/img/perfiles/(.+)$
	redir @legacy_profiles /media/perfiles/{re.legacy_profiles.1} 308

	@legacy_static_profiles path_regexp legacy_static_profiles ^/static/img/perfiles/(.+)$
	redir @legacy_static_profiles /media/perfiles/{re.legacy_static_profiles.1} 308

	@legacy_forum path_regexp legacy_forum ^/static/img/posts/(.+)$
	redir @legacy_forum /media/foro/{re.legacy_forum.1} 308

	handle /media/* {
		reverse_proxy media_static:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	@api path /api /api/* /zw-docs /zw-docs/* /zw-openapi.json /zw-redoc /zw-redoc/*
	handle @api {
		reverse_proxy nginx_api:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	@admin path /zw-interno /zw-interno/*
	handle @admin {
		reverse_proxy nginx_api:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy cliente:5000 {
			header_up X-Real-IP {remote_host}
		}
	}
}
