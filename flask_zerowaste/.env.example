# ===== Flask ZeroWaste — Variables de Entorno =====
# Copia este archivo como .env y rellena los valores

SECRET_KEY=your_secret_key_here
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/zerowaste_db
FLASK_DEBUG=false

# Email via Resend HTTP API (SMTP bloqueado en DigitalOcean)
# Registrarse en https://resend.com y verificar dominio
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=noreply@zerowaste-qro.com
MAIL_FROM_NAME=Zero Waste

# FastAPI public URL (accesible por el navegador del usuario)
PUBLIC_API_URL=http://zerowaste-qro.com/api
