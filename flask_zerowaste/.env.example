# ===== Flask ZeroWaste — Variables de Entorno =====
# Copia este archivo como .env y rellena los valores

SECRET_KEY=your_secret_key_here
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/zerowaste_db
FLASK_DEBUG=false

# Email SMTP (Gmail App Password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# FastAPI public URL (accesible por el navegador del usuario)
PUBLIC_API_URL=http://localhost:6001
