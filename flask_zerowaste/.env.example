# Plantilla solamente. Nunca almacenes credenciales reales en Git.
APP_ENV=production
SECRET_KEY=
DATABASE_URL=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
# Optional: verify compatibility with the selected Supabase connection/pooler.
DB_STATEMENT_TIMEOUT_MS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
FLASK_DEBUG=false
HTTPS_ENABLED=true
ALLOWED_ORIGINS=https://zerowaste-qro.com,https://www.zerowaste-qro.com

# Email via Resend HTTP API (SMTP bloqueado en DigitalOcean)
# Registrarse en https://resend.com y verificar dominio
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=ZeroWaste
RESEND_REPLY_TO=
PUBLIC_BASE_URL=https://www.zerowaste-qro.com
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30

# FastAPI public URL (accesible por el navegador del usuario)
PUBLIC_API_URL=https://www.zerowaste-qro.com/api

# Token público (pk.*) usado por Mapbox GL JS. Nunca uses un token secreto sk.*.
MAPBOX_PUBLIC_TOKEN=
