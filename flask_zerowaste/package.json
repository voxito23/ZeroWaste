{
  "name": "flask-zerowaste",
  "version": "1.0.0",
  "description": "Tailwind build setup for Flask ZeroWaste",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/css/output.css --minify",
    "dev:css": "tailwindcss -i ./static/src/input.css -o ./static/css/output.css --watch --poll"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/container-queries": "^0.1.1"
  }
}
