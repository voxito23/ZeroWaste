# Plantilla solamente. Nunca almacenes credenciales reales en Git.
APP_ENV=production
DATABASE_URL=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
# Optional: verify compatibility with the selected Supabase connection/pooler.
DB_STATEMENT_TIMEOUT_MS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
SYSTEM_API_KEY=
QR_TOKEN_ENCRYPTION_KEY=
AUTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.zerowaste-qro.com/api/auth/google/callback
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@zerowaste-qro.com
MAIL_FROM_NAME=ZeroWaste
SUPPORT_EMAIL=soporte@zerowaste-qro.com
ALLOWED_ORIGINS=https://zerowaste-qro.com,https://www.zerowaste-qro.com
