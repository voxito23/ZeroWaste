{
  "expo": {
    "name": "ZeroWaste",
    "slug": "zerowaste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/zerowaste-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0FDF4",
        "foregroundImage": "./assets/branding/zerowaste-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.vic45.mobile_app"
    },
    "scheme": "zerowaste",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/zerowaste-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F0FDF4"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ZeroWaste necesita acceder a tu ubicación para mostrarte los centros de acopio cercanos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ZeroWaste necesita la cámara para validar códigos QR de recolecciones.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ZeroWaste necesita acceso a tus fotos para adjuntar imágenes a publicaciones.",
          "cameraPermission": "ZeroWaste necesita la cámara para tomar imágenes para publicaciones."
        }
      ],
      "@rnmapbox/maps"
    ],
    "extra": {
      "eas": {
        "projectId": "8fb4a3cb-8dc7-4b1c-935c-dcbce54979ab"
      }
    },
    "owner": "vic45"
  }
}
