{
  "expo": {
    "name": "ZeroWaste",
    "slug": "zerowaste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/zerowaste-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F0FDF4",
        "foregroundImage": "./assets/branding/zerowaste-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.vic45.mobile_app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.zerowaste-qro.com",
              "pathPrefix": "/app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "scheme": "zerowaste",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/zerowaste-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F0FDF4"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ZeroWaste necesita acceder a tu ubicación para mostrarte los centros de acopio cercanos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ZeroWaste necesita la cámara para validar códigos QR de recolecciones.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ZeroWaste necesita acceso a tus fotos para actualizar tu perfil y adjuntar imágenes a publicaciones.",
          "cameraPermission": "ZeroWaste necesita la cámara para actualizar tu perfil y tomar imágenes para publicaciones."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#047857",
          "defaultChannel": "zerowaste-general"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      "@rnmapbox/maps"
    ],
    "extra": {
      "eas": {
        "projectId": "8fb4a3cb-8dc7-4b1c-935c-dcbce54979ab"
      }
    },
    "owner": "vic45"
  }
}
