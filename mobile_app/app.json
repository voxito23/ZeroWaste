{
  "expo": {
    "name": "ZeroWaste",
    "slug": "mobile_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/zerowaste-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0FDF4",
        "foregroundImage": "./assets/branding/zerowaste-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.vic45.mobile_app"
    },
    "scheme": "zerowaste",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/zerowaste-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F0FDF4"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ZeroWaste necesita acceder a tu ubicación para mostrarte los centros de acopio cercanos."
        }
      ],
      "@rnmapbox/maps"
    ],
    "extra": {
      "eas": {
        "projectId": "103770e7-e3cd-4b91-adf4-d71942d06165"
      }
    }
  }
}
