# Copy manually to /opt/ZeroWaste/.env.node (mode 600); never commit real values.
INSTANCE_NAME=
NODE_ROLE=
APP_VERSION=
PUBLIC_BASE_URL=https://www.zerowaste-qro.com

DATABASE_URL=
REDIS_URL=
APP_KEY=
JWT_SECRET=

SESSION_DRIVER=redis
SESSION_COOKIE=zerowaste_admin_session
SESSION_DOMAIN=.zerowaste-qro.com
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
CACHE_PREFIX=zerowaste:cache:
REDIS_PREFIX=zerowaste:session:
REDIS_LOGIN_PREFIX=zerowaste:login:
REDIS_QUEUE=zerowaste:queue:default
REDIS_LOCK_PREFIX=zerowaste:locks:

MEDIA_DISK=s3
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_PUBLIC_URL=

MAIL_PROVIDER=
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ZeroWaste
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDFLARE_ORIGIN_CERT_PATH=
CLOUDFLARE_ORIGIN_KEY_PATH=
TRUSTED_PROXY_CIDRS=
MONITORING_PEER_ADDRESS=
MONITORING_NODE_ADDRESS=127.0.0.1
LOAD_BALANCER_HEALTH_PATH=/load-balancer-health
LOAD_BALANCER_READY_PATH=/load-balancer-ready
WIREGUARD_ADDRESS=
WIREGUARD_PEER_ADDRESS=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
